        "inputSchema": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"recipes\": {\n      \"type\": \"array\",\n        \"minItems\": 3,\n        \"maxItems\": 3,\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"title\": { \"type\": \"string\", \"description\": \"Kurzer Rezeptname (optional)\" },\n          \"description\": { \"type\": \"string\", \"description\": \"Kurzbeschreibung des Gerichts\" },\n          \"ingredients\": {\n            \"type\": \"array\",\n            \"items\": { \"type\": \"string\" },\n            \"description\": \"Zutatenzeilen als lesbare Strings, z. B. '200 g Reis'\"\n          },\n          \"steps\": {\n            \"type\": \"array\",\n            \"items\": { \"type\": \"string\" },\n            \"description\": \"Zubereitungsschritte in Reihenfolge\"\n          },\n          \"calories\": { \"type\": \"number\", \"description\": \"Kalorien pro Portion (kcal)\" },\n          \"fats\": { \"type\": \"number\", \"description\": \"Fett in g pro Portion\" },\n          \"carbs\": { \"type\": \"number\", \"description\": \"Kohlenhydrate in g pro Portion\" },\n          \"protein\": { \"type\": \"number\", \"description\": \"Protein in g pro Portion\" },\n          \"portions\": { \"type\": \"number\", \"description\": \"Anzahl der Portionen, die das Rezept ergibt\" },\n          \"cooks\": { \"type\": \"number\", \"description\": \"Anzahl der Köche, die für die Zubereitung sinnvoll sind\" },\n          \"cookingTime\": { \"type\": \"string\", \"enum\": [\"quick\", \"medium\", \"complex\"], \"description\": \"Zeitkategorie der Zubereitung\" },\n          \"cuisine\": { \"type\": \"string\", \"enum\": [\"german\", \"italian\", \"indian\", \"japanese\", \"gourmet\", \"fusion\"], \"description\": \"Küchenstil des Rezepts\" },\n          \"diet\": { \"type\": \"string\", \"enum\": [\"vegetarian\", \"vegan\", \"keto\", \"none\"], \"description\": \"Ernährungsform, die das Rezept erfüllt\" }\n        },\n        \"required\": [\"description\", \"ingredients\", \"steps\", \"calories\", \"fats\", \"carbs\", \"protein\", \"portions\", \"cooks\", \"cookingTime\", \"cuisine\", \"diet\"],\n        \"additionalProperties\": false\n      }\n    }\n  },\n  \"required\": [\"recipes\"]\n}\n"
